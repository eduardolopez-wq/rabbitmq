{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "createElement",
    "jsxFragmentFactory": "Fragment",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "baseUrl": ".",
    "paths": {
      "preact": ["../../node_modules/preact/src/index.d.ts"],
      "preact/hooks": ["../../node_modules/preact/hooks/src/index.d.ts"],
      "@shopify/ui-extensions/*": ["../../node_modules/@shopify/ui-extensions/build/ts/*"]
    }
  },
  "include": ["src/**/*"]
}
