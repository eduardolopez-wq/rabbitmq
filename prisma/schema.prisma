// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// Connection URL lives in prisma.config.ts (Prisma ORM 7+).
datasource db {
  provider = "sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SeenAddress {
  addressShopId   BigInt
  customerShopId  BigInt
  shop            String
  createdAt       DateTime @default(now())

  @@id([addressShopId, shop])
}

/// Credenciales y PDS por tienda (RabbitMQ). Configuración embebida en admin.
model ShopIntegrationSettings {
  shop             String   @id
  rabbitmqHost     String   @default("")
  rabbitmqUser     String   @default("")
  rabbitmqPassword String   @default("")
  rabbitmqPort     Int      @default(5672)
  rabbitmqVhost    String   @default("/")
  pdsApiKey        String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Opciones del formulario de datos personales (extensión cuenta cliente), por tienda.
model ShopProfileFormSettings {
  shop String @id
  /** Si es true, el formulario cuenta cliente muestra España + Portugal; si false, solo ES (sin selector país). */
  profileFormEnablePortugal Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
